{
  "name": "jdbc-sink-orders-enriched",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "orders-enriched",
    "connection.url": "jdbc:postgresql://postgres:5432/kafkamart",
    "connection.user": "kafkamart",
    "connection.password": "kafkamart",
    "table.name.format": "enriched_orders",
    "insert.mode": "upsert",
    "pk.mode": "record_key",
    "pk.fields": "orderId",
    "delete.enabled": "false",
    "auto.create": "true",
    "auto.evolve": "true",
    "quote.sql.identifiers": "always",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "infer,insertTs",
    "transforms.infer.type": "com.kafkamart.connect.InferConnectSchema$Value",
    "transforms.infer.exclude": "items",
    "transforms.insertTs.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.insertTs.timestamp.field": "ingested_at",
    "errors.tolerance": "all",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true"
  }
}
