# KafkaMart local stack — no production secrets
COMPOSE_PROJECT_NAME=kafkamart

KAFKA_BROKER_ID=1
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9092

SCHEMA_REGISTRY_PORT=8083
SCHEMA_REGISTRY_URL=http://localhost:8083
SCHEMA_REGISTRY_URL_INTERNAL=http://schema-registry:8083

CONNECT_PORT=8092
CONNECT_URL=http://localhost:8092

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

CLUSTER_ID=kafkamart-local-cluster
