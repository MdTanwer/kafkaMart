# KafkaMart local stack — no production secrets
COMPOSE_PROJECT_NAME=kafkamart

CLUSTER_ID=kafkamart-local-cluster

KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka-1:19092,kafka-2:19092,kafka-3:19092

SCHEMA_REGISTRY_PORT=8181
SCHEMA_REGISTRY_URL=http://localhost:8181
SCHEMA_REGISTRY_URL_INTERNAL=http://schema-registry:8181

CONNECT_PORT=8083
CONNECT_URL=http://localhost:8083

KAFKA_UI_PORT=9000
POSTGRES_PORT=5432
POSTGRES_DB=kafkamart
POSTGRES_USER=kafkamart
POSTGRES_PASSWORD=kafkamart

ELASTICSEARCH_PORT=9200

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
