# KafkaMart local stack — versions and ports (no production secrets)
COMPOSE_PROJECT_NAME=kafkamart

# Static KRaft cluster id (base64 UUID). Must be identical on all 3 brokers.
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

CONFLUENT_VERSION=7.8.0
POSTGRES_VERSION=16
ELASTICSEARCH_VERSION=8.15.3
PROMETHEUS_VERSION=v2.54.1
GRAFANA_VERSION=11.2.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest

KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka-1:19092,kafka-2:19092,kafka-3:19092

SCHEMA_REGISTRY_PORT=8181
SCHEMA_REGISTRY_URL=http://localhost:8181
SCHEMA_REGISTRY_URL_INTERNAL=http://schema-registry:8181

CONNECT_PORT=8083
CONNECT_URL=http://localhost:8083

KAFKA_UI_PORT=9000
POSTGRES_PORT=5432
POSTGRES_DB=kafkamart
POSTGRES_USER=kafkamart
POSTGRES_PASSWORD=kafkamart

ELASTICSEARCH_PORT=9200

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
